{
  "expo": {
    "name": "Focus Games",
    "slug": "eegkit-neurofeedback",
    "description": "Attention games driven by EEG neurofeedback, for children with ADHD and the grown-ups who support them. Not a medical device.",
    "version": "0.2.0",
    "scheme": "eegkit-neurofeedback",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0E17",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.aliassar.eegkitneurofeedback"
    },
    "android": {
      "package": "io.github.aliassar.eegkitneurofeedback",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E17",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Focus Games",
      "shortName": "Focus Games",
      "themeColor": "#0A0E17",
      "backgroundColor": "#0A0E17",
      "description": "Attention games driven by EEG neurofeedback. Playable in the browser with simulated EEG. Not a medical device."
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/eegkit-neurofeedback"
    }
  }
}
