{
  "name": "eegkit-neurofeedback",
  "version": "0.2.0",
  "description": "Focus Games: open-source EEG attention games for children with ADHD, for web, iOS and Android. Built on eegkit and eegkit-react. Not a medical device.",
  "license": "MIT",
  "author": "Ali Assar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliassar/eegkit-neurofeedback.git"
  },
  "homepage": "https://aliassar.github.io/eegkit-neurofeedback/",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bridge:edf": "node bridge/replay-edf.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "eegkit": "github:aliassar/eegkit#v0.1.0",
    "eegkit-react": "github:aliassar/eegkit-react#v0.1.0",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  }
}
